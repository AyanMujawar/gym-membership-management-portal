# Local overrides (copy to .env). Every value has a safe local default in docker-compose.yml.
# On the server, Ansible writes the real .env from GitHub Secrets; it is never committed.
DB_PASSWORD=password
SECRET_KEY=dev-secret-key-change-in-production
APP_ENV=development
GRAFANA_ADMIN_PASSWORD=admin
BACKEND_IMAGE=gym-portal-backend:local
FRONTEND_IMAGE=gym-portal-frontend:local
