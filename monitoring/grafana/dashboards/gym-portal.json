    {
      "id": 22,
      "type": "stat",
      "title": "Availability (SLO 99.5%)",
      "description": "Share of time the API was reachable",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * avg_over_time(up{job=\"gym-backend\"}[$__range])",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
